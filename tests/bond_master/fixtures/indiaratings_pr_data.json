    "overview": "<p class=\"Body\" style=\"margin-bottom:0in;margin-bottom:.0001pt;line-height:normal\"></p><div style=\"text-align: justify;\"><span style=\"font-family: &quot;Times New Roman&quot;, serif; font-size: 10pt;\">India Ratings and Research (Ind-Ra) has withdrawn the ratings of Tata\r\nCapital Financial Services Limited\u2019s (TCFSL) debt instruments as follows:</span></div><div style=\"text-align: justify;\"><span style=\"font-family: &quot;Times New Roman&quot;, serif; font-size: 13.3333px;\"><br></span></div><span style=\"font-family: &quot;Times New Roman&quot;, serif; font-size: 10pt;\"><o:p></o:p></span><p></p>",
    "overviewHTML": "",
    "keyRatingDrivers": "<p class=\"Body\" style=\"margin-bottom:0in;margin-bottom:.0001pt;line-height:normal\"></p><div style=\"text-align: justify;\"><span lang=\"EN-GB\" style=\"font-size: 10pt; font-family: &quot;Times New Roman&quot;, serif;\">Ind-Ra<b> </b></span><span lang=\"EN-GB\" style=\"background-image: initial; background-position: initial; background-size: initial; background-repeat: initial; background-attachment: initial; background-origin: initial; background-clip: initial; font-size: 10pt; color: black;\">is no longer required to\r\nmaintain the ratings as </span><span lang=\"EN-GB\" style=\"font-size: 10pt; font-family: &quot;Times New Roman&quot;, serif;\">TCFSL</span><span lang=\"EN-GB\" style=\"background-image: initial; background-position: initial; background-size: initial; background-repeat: initial; background-attachment: initial; background-origin: initial; background-clip: initial; font-size: 10pt; color: black;\"> has been merged with </span><span lang=\"EN-GB\" style=\"font-size: 10pt; font-family: &quot;Times New Roman&quot;, serif;\">Tata\r\nCapital Limited (debt rated at \u2018IND AAA\u2019/Stable)</span><span lang=\"EN-GB\" style=\"background-image: initial; background-position: initial; background-size: initial; background-repeat: initial; background-attachment: initial; background-origin: initial; background-clip: initial; font-size: 10pt; color: black;\">&nbsp;and all of its debt\r\ninstruments have been transferred to TCL.</span><b><span lang=\"EN-GB\" style=\"font-size:10.0pt;font-family:&quot;Times New Roman&quot;,serif\">\r\n</span></b><span lang=\"EN-GB\" style=\"font-size: 10pt; font-family: &quot;Times New Roman&quot;, serif;\">On\r\n1 January 2024, TCL, via its stock exchange disclosure, announced the\r\namalgamation of TCFSL and Tata Cleantech Capital Limited with itself, effective\r\n1 January 2024 post receiving approvals from all the requisite shareholders,\r\ncreditors and regulatory/statutory authorities.</span></div><span lang=\"EN-GB\" style=\"font-size:10.0pt;font-family:&quot;Times New Roman&quot;,serif\"><div style=\"text-align: justify;\"><br></div></span><p></p>",
    "ratingSensitivities": "",
    "esg": "<p class=\"Body\" style=\"margin-bottom:0in;margin-bottom:.0001pt;line-height:normal\"></p><div style=\"text-align: justify;\"><b><span lang=\"EN-GB\" style=\"font-size: 10pt; font-family: &quot;Times New Roman&quot;, serif; background-image: initial; background-position: initial; background-size: initial; background-repeat: initial; background-attachment: initial; background-origin: initial; background-clip: initial;\">ESG Factors Minimally Relevant to Rating:</span></b><span lang=\"EN-GB\" style=\"background-image: initial; background-position: initial; background-size: initial; background-repeat: initial; background-attachment: initial; background-origin: initial; background-clip: initial; font-size: 10pt; font-family: &quot;Times New Roman&quot;, serif;\">&nbsp;Unless otherwise disclosed in\r\nthis section, the ESG issues are credit neutral or have only a minimal credit\r\nimpact on TCFSL, due to either their nature or the way in which they are being\r\nmanaged by the entity. For more information on Ind-Ra\u2019s ESG Relevance\r\nDisclosures, please click&nbsp;</span><span lang=\"EN-GB\"><a href=\"https://www.indiaratings.co.in/PressRelease?pressReleaseID=56916&amp;title=India%20Ratings%20Launches%20ESG%20Relevance%20Disclosure%20to%20Show%20Impact%20of%20ESG%20on%20Credit\"><span style=\"font-size: 10pt; font-family: &quot;Times New Roman&quot;, serif; background-image: initial; background-position: initial; background-size: initial; background-repeat: initial; background-attachment: initial; background-origin: initial; background-clip: initial; text-decoration-line: underline;\">here</span></a></span><span lang=\"EN-GB\" style=\"background-image: initial; background-position: initial; background-size: initial; background-repeat: initial; background-attachment: initial; background-origin: initial; background-clip: initial; font-size: 10pt; font-family: &quot;Times New Roman&quot;, serif;\">. For answers to frequently asked questions\r\nregarding ESG Relevance Disclosures and their impact on ratings, please click&nbsp;</span><span lang=\"EN-GB\"><a href=\"https://www.indiaratings.co.in/PressRelease?pressReleaseID=57016\"><span style=\"font-size: 10pt; font-family: &quot;Times New Roman&quot;, serif; background-image: initial; background-position: initial; background-size: initial; background-repeat: initial; background-attachment: initial; background-origin: initial; background-clip: initial; text-decoration-line: underline;\">here</span></a></span><span lang=\"EN-GB\" style=\"background-image: initial; background-position: initial; background-size: initial; background-repeat: initial; background-attachment: initial; background-origin: initial; background-clip: initial; font-size: 10pt; font-family: &quot;Times New Roman&quot;, serif;\">.</span></div><span lang=\"EN-GB\" style=\"background-image: initial; background-position: initial; background-size: initial; background-repeat: initial; background-attachment: initial; background-origin: initial; background-clip: initial; font-family: &quot;Times New Roman&quot;, serif; font-size: 13.3333px;\"><div style=\"text-align: justify;\"><br></div></span><span lang=\"EN-GB\" style=\"font-size:10.0pt;\r\nmso-bidi-font-size:12.0pt;font-family:&quot;Times New Roman&quot;,serif\"><o:p></o:p></span><p></p>",
    "companyProfile": "<p class=\"Body\" style=\"margin-bottom:0in;margin-bottom:.0001pt;line-height:normal\"></p><div style=\"text-align: justify;\"><span style=\"font-family: &quot;Times New Roman&quot;, serif; font-size: 10pt;\">TCFSL became\r\na wholly-owned subsidiary of TCL from 1 January 2024 post its merger, and\r\nhouses the corporate loans and non-housing retail loans business. The company\r\nstarted operations in 2007 and had a balance sheet size of INR794 billion at\r\nend-September 2023.</span></div><span lang=\"EN-GB\" style=\"font-size:10.0pt;font-family:&quot;Times New Roman&quot;,serif\"><div style=\"text-align: justify;\"><span style=\"font-size: 10pt;\">&nbsp;</span></div><o:p></o:p></span><p></p>",
