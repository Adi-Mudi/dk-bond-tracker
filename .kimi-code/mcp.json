{
  "mcpServers": {
    "sqlite-app-data": {
      "command": "/home/user/.local/bin/uvx",
      "args": [
        "mcp-alchemy"
      ],
      "env": {
        "DB_URL": "sqlite:///file:/workspace/01_excel_dashboard/data/bonds.db?mode=ro&uri=true"
      },
      "deferred": true
    },
    "sqlite-excel-dashboard": {
      "command": "/home/user/.local/bin/uvx",
      "args": [
        "mcp-alchemy"
      ],
      "env": {
        "DB_URL": "sqlite:////workspace/01_excel_dashboard/db-store/store/dk-bond-tracker_store.db"
      },
      "deferred": true
    }
  }
}